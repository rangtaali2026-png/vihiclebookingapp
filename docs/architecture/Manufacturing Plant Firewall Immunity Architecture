### Backend Queue & Message Consumer Workflow

The frontend triggers a clean state change (e.g., `POST /api/bookings/approve`). The Cloudflare Worker writes to Supabase and immediately pushes the payload to the queue before returning `HTTP 200` to the client in under 50ms.

#### 1. API Route Worker (`producer.ts`)

```typescript
export interface Env {
  NOTIFICATIONS_QUEUE: Queue;
  SUPABASE_URL: string;
  SUPABASE_SERVICE_ROLE_KEY: string;
}

export default {
  async fetch(request: Request, env: Env): Promise<Response> {
    const url = new URL(request.url);

    if (request.method === "POST" && url.pathname === "/api/bookings/approve") {
      const { bookingId, siteId } = await request.json();

      // 1. Mutate state in Supabase via REST (Port 443 HTTPS)
      // 2. Enqueue notification payload asynchronously
      await env.NOTIFICATIONS_QUEUE.send({
        event: "BOOKING_APPROVED",
        bookingId,
        siteId,
        timestamp: new Date().toISOString()
      });

      return new Response(JSON.stringify({ success: true, message: "Booking approved and queued" }), {
        headers: { "Content-Type": "application/json" }
      });
    }

    return new Response("Not Found", { status: 404 });
  }
};

```

#### 2. Queue Consumer Worker (`consumer.ts`)

```typescript
export default {
  async queue(batch: MessageBatch<any>, env: Env): Promise<void> {
    for (const message of batch.messages) {
      const { event, bookingId, siteId } = message.body;

      if (event === "BOOKING_APPROVED") {
        // Fetch trip and recipient details securely from Supabase
        // Execute outbound calls to WhatsApp Business API & SMS Gateway
        await dispatchWhatsAppAlert(bookingId, env);
        await dispatchSMSAlert(bookingId, env);
      }
      message.ack(); // Acknowledge message delivery
    }
  }
};

```

